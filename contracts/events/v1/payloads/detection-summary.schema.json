{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-monitoring.local/contracts/events/v1/payloads/detection-summary.schema.json",
  "title": "Detection Summary Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["frameTimestamp", "imageWidth", "imageHeight", "detections", "processTimeMs"],
  "properties": {
    "frameTimestamp": { "type": "string", "format": "date-time" },
    "imageWidth": { "type": "integer", "minimum": 1 },
    "imageHeight": { "type": "integer", "minimum": 1 },
    "processTimeMs": { "type": "number", "minimum": 0 },
    "detections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["className", "confidence", "bboxXyxy"],
        "properties": {
          "className": { "type": "string", "enum": ["fire", "smoke"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bboxXyxy": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0 }
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}

