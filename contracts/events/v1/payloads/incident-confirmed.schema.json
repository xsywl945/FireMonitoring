{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-monitoring.local/contracts/events/v1/payloads/incident-confirmed.schema.json",
  "title": "Incident Confirmed Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dedupKey", "primaryType", "severity", "fusionScore", "startedAt", "confirmedAt", "observations"],
  "properties": {
    "dedupKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "primaryType": { "type": "string", "enum": ["FIRE", "SMOKE", "FIRE_AND_SMOKE"] },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "fusionMode": { "type": "string", "enum": ["SINGLE_CAMERA", "DUAL_CAMERA"] },
    "fusionScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "confirmedAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cameraId", "viewRole", "className", "score", "effectiveFrames", "durationMs"],
        "properties": {
          "cameraId": { "type": "integer", "minimum": 1 },
          "viewRole": { "type": "string", "enum": ["VIEW_A", "VIEW_B", "SINGLE"] },
          "className": { "type": "string", "enum": ["fire", "smoke"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "effectiveFrames": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "snapshotObjectKey": { "type": ["string", "null"] }
        }
      }
    }
  }
}

