{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-monitoring.local/contracts/events/v1/payloads/vlm-analysis.schema.json",
  "title": "VLM Analysis Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "model", "promptVersion"],
  "properties": {
    "incidentId": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "type": "string", "enum": ["SUCCEEDED", "FAILED", "DEMO_FALLBACK"] },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "promptVersion": { "type": "string" },
    "hasVisibleFire": { "type": ["boolean", "null"] },
    "hasVisibleSmoke": { "type": ["boolean", "null"] },
    "sourceNature": {
      "type": ["string", "null"],
      "enum": ["electrical", "open_flame", "chemical", "cooking", "unknown", null]
    },
    "sceneType": {
      "type": ["string", "null"],
      "enum": ["classroom", "laboratory", "corridor", "other", null]
    },
    "riskLevel": {
      "type": ["string", "null"],
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
    },
    "reasoningSummary": { "type": ["string", "null"], "maxLength": 1000 },
    "recommendedActions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 },
      "maxItems": 10
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 },
      "maxItems": 10
    },
    "errorCode": { "type": ["string", "null"] },
    "latencyMs": { "type": ["number", "null"], "minimum": 0 }
  }
}
