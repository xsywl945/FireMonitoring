{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-monitoring.local/contracts/events/v1/payloads/incident-evidence-ready.schema.json",
  "title": "Incident Evidence Ready Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence"],
  "properties": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cameraId", "viewRole", "capturedAt", "imageWidth", "imageHeight", "detections", "temporalScore"],
        "properties": {
          "cameraId": { "type": "integer", "minimum": 1 },
          "viewRole": { "type": "string", "enum": ["VIEW_A", "VIEW_B", "SINGLE"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "imageWidth": { "type": "integer", "minimum": 1 },
          "imageHeight": { "type": "integer", "minimum": 1 },
          "detections": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["className", "confidence", "bboxXyxy"],
              "properties": {
                "className": { "type": "string", "enum": ["fire", "smoke"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "bboxXyxy": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          "temporalScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "snapshotObjectKey": { "type": ["string", "null"] }
        }
      }
    }
  }
}
