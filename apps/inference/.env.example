INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8091
INFERENCE_SOURCE=inference-worker-1
INFERENCE_MODEL_VERSION=mock-fire-yolo-0.1.0
INFERENCE_REDIS_URL=redis://127.0.0.1:6379/0
INFERENCE_REDIS_STREAM=monitoring.events
INFERENCE_TEMPORAL_N=3
INFERENCE_TEMPORAL_M=5
INFERENCE_CANDIDATE_N=1
INFERENCE_MIN_CONFIDENCE=0.45
INFERENCE_CLEAR_FRAMES=3
INFERENCE_COOLDOWN_MS=10000
INFERENCE_FUSION_WINDOW_MS=500

# Cloud credentials must be injected locally and must never be committed.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus

INFERENCE_MINIO_ENDPOINT=127.0.0.1:9000
INFERENCE_MINIO_SECURE=false
