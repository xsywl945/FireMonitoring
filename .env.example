# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
INFERENCE_MODEL_VERSION=yolo11s-fire-smoke-primary-v2

MYSQL_DATABASE=fire_monitoring
MYSQL_USER=fire_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

REDIS_PASSWORD=change-redis-me

MINIO_ROOT_USER=fire_minio
MINIO_ROOT_PASSWORD=change-minio-me
MINIO_BUCKET=fire-evidence

JWT_SECRET=replace-with-at-least-32-random-bytes
CAMERA_CREDENTIAL_KEY=replace-with-32-byte-base64-key
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=123456

# Alibaba Cloud Model Studio (Python inference service)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
INFERENCE_VLM_GATE_ENABLED=true
INFERENCE_VLM_GATE_MIN_CONFIDENCE=0.70
# false = 云端失败时保留为本地候选，不触发正式报警
INFERENCE_VLM_GATE_FAIL_OPEN=false

# Alibaba Cloud SMS (Spring service)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_DEMO_ARMED=false
SMS_DEMO_RECIPIENTS=
